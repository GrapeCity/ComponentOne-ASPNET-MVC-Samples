  <Report ref="1">
    <Name>Top5RevenueCategories</Name>
    <DataSourceName>Main</DataSourceName>
    <Layout>
      <Width>10800</Width>
      <Margin>0</Margin>
      <MarginTop>0</MarginTop>
      <MarginRight>0</MarginRight>
      <MarginBottom>0</MarginBottom>
      <Orientation>Portrait</Orientation>
      <CustomPageWidth>12240</CustomPageWidth>
      <CustomPageHeight>15840</CustomPageHeight>
    </Layout>
    <Fonts>
      <Font>
        <Name>Segoe UI</Name>
        <Size>9</Size>
      </Font>
    </Fonts>
    <DataSources>
      <DataSource>
        <Name>Main</Name>
        <DataProvider>DbProviderFactory</DataProvider>
        <ConnectionString>Data Source=|DataDirectory|\C1NWind.db</ConnectionString>
        <FactoryName>System.Data.SQLite</FactoryName>
        <RecordSource>
            SELECT * FROM (SELECT *
            FROM (SELECT Item_Category, sum(NetRevenue) as totalRevenue, (select Sum(NetRevenue) from InventoryManagement) as total
            FROM InventoryManagement
            group by Item_Category LIMIT 5)  AS t
            ORDER BY TotalRevenue DESC) AS t1
            UNION select 'Remaining Categories',(select Sum(NetRevenue) from InventoryManagement where  Item_Category not In (SELECT Item_Category
            FROM (SELECT Item_Category, sum(NetRevenue) as totalRevenue, (select Sum(NetRevenue) from InventoryManagement LIMIT 5) as total
            FROM InventoryManagement group by Item_Category)  AS t
            ORDER BY TotalRevenue DESC)) as totalRevenue, (select Sum(NetRevenue) from InventoryManagement) as total
            FROM InventoryManagement;</RecordSource>
      </DataSource>
    </DataSources>
