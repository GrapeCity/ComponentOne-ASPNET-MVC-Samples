        <SubSections>
          <SubSection>
            <Name>SubSection1</Name>
          </SubSection>
        </SubSections>
        <Type>PageHeader</Type>
      </Section>
      <Section>
        <Name>PageFooter</Name>
        <SubSections>
          <SubSection>
            <Name>SubSection1</Name>
          </SubSection>
        </SubSections>
        <Type>PageFooter</Type>
      </Section>
    </Sections>
    <Fields>
      <FlexChartField>
        <Name>字段1</Name>
        <Background type="Solid">
          <Color>FFFFFFFF</Color>
        </Background>
        <Section>Header</Section>
        <Left>576</Left>
        <Top>5125</Top>
        <Width>10179</Width>
        <Height>6000</Height>
        <Font>
          <Name>Segoe UI</Name>
          <Size>9</Size>
        </Font>
        <Legend>
          <Position>None</Position>
        </Legend>
        <Palette>Modern</Palette>
        <CategoryGroups>
          <FlexChartDataGroup>
            <GroupExpression>OrderYear + ""</GroupExpression>
          </FlexChartDataGroup>
        </CategoryGroups>
        <Series>
          <FlexChartSeries>
            <YExpressions>
              <Item sys="string">OrderCount</Item>
            </YExpressions>
            <Label>
              <Value>OrderCount</Value>
            </Label>
          </FlexChartSeries>
        </Series>
        <ChartType>Bar</ChartType>
      </FlexChartField>
      <Field>
        <Name>Field40</Name>
        <Background type="Solid">
          <Color>FFF1F1F1</Color>
        </Background>
        <Section>Header</Section>
        <Left>0</Left>
        <Top>0</Top>
        <Width>10755</Width>
        <Height>1110</Height>
        <ZOrder>-9</ZOrder>
        <Font>
          <Name>Segoe UI Light</Name>
          <Bold>true</Bold>
          <Size>9.75</Size>
        </Font>
      </Field>
      <Field>
        <Name>Field44</Name>
        <Section>Header</Section>
        <Left>0</Left>
        <Top>0</Top>
        <Width>6525</Width>
        <Height>1110</Height>
        <MarginLeft>576</MarginLeft>
        <MarginBottom>172.8</MarginBottom>
        <Text>Bar Chart</Text>
        <Align>LeftBottom</Align>
        <ForeColor>FF551E5F</ForeColor>
        <Font>
          <Name>Segoe UI Light</Name>
          <Size>23</Size>
        </Font>
      </Field>
      <Field>
        <Name>ftrLeft2</Name>
        <Section>Header</Section>
        <Left>0</Left>
        <Top>1380</Top>
        <Width>5164</Width>
        <Height>435</Height>
        <MarginLeft>576</MarginLeft>
        <Text>Now()</Text>
        <Calculated>true</Calculated>
        <Format>Long Date</Format>
        <Align>LeftMiddle</Align>
        <ForeColor>FF551E5F</ForeColor>
        <Font>
          <Name>Segoe UI Light</Name>
          <Size>12</Size>
        </Font>
      </Field>
      <Field>
        <Name>Field5</Name>
        <Section>Header</Section>
        <Left>0</Left>
        <Top>2235</Top>
        <Width>10755</Width>
        <Height>2025</Height>
        <MarginLeft>576</MarginLeft>
        <AutoHeight>GrowAndShrink</AutoHeight>
        <Text>This chart draws each series as a horizontal bar in a cluster.
              Properties are set as following:
              •  ChartType: Bar
              •  DataSource: The orders count of each year
              •  DataX: OrderYear + "". Holds the position on the X-axis.
              •  DataY: OrderCount. Holds the position on the Y-axis.
              •  LabelCompass: East. Shows data label on right of each bar.
          </Text>
        <Align>LeftTop</Align>
        <Font>
          <Name>Segoe UI Light</Name>
          <Size>10.5</Size>
        </Font>
      </Field>
      <Field>
        <Name>Field47</Name>
        <Section>Header</Section>
        <Left>6525</Left>
        <Top>0</Top>
        <Width>4230</Width>
        <Height>1110</Height>
        <MarginRight>244.8</MarginRight>
        <PictureAlign>RightMiddle</PictureAlign>
        <Font>
          <Name>Segoe UI Light</Name>
          <Size>9</Size>
        </Font>
        <Picture>
          <Image></Image>
        </Picture>
      </Field>
    </Fields>
    <Culture>en-US</Culture>
  </Report>
