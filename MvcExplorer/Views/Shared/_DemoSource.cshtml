@model IDictionary<string, string>
@if (Model != null)
{
    <div id="sourceTab" class="nav nav-tabs ui-helper-clearfix mob-hide-1">
        @foreach (var pageSource in Model)
        {
            <div>
                <a>@pageSource.Key</a>
                @{
                    var className = "brush:c#;";
                    if (pageSource.Key.Contains(".cshtml"))
                    {
                        className = "brush:js;html-script:true;";
                    }
                }
                @if (pageSource.Value.StartsWith(Resources.Resource.MissingSourceFileCode))
                {
                    <div class="tab-pane pane-content mob-hide-1">
                        <h4><span style='color:red'>@pageSource.Value</span></h4>
                    </div>
                }
                 else
                {
                    <div class="tab-pane pane-content mob-hide-1">
                        <pre class=@className>@pageSource.Value</pre>
                    </div>
                }
                
                
            </div>
        }
    </div>
    @Html.C1().TabPanel("#sourceTab")
}