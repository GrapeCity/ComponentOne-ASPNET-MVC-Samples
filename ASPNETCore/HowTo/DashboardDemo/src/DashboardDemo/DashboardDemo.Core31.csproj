<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <AssemblyName>DashboardDemo</AssemblyName>
    <RootNamespace>DashboardDemo</RootNamespace>
    <MvcRazorCompileOnPublish>false</MvcRazorCompileOnPublish>
    <DefineConstants>$(DefineConstants);NETCORE31</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>TRACE;DEBUG;NET461;ASPNETCORE;NETCORE31</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE;RELEASE;NET461;ASPNETCORE;NETCORE31</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="C1.AspNetCore.Mvc" Version="6.0.20262.477" />
    <PackageReference Include="C1.AspNetCore.Mvc.FlexViewer" Version="6.0.20262.477" />
    <PackageReference Include="C1.AspNetCore.Mvc.Olap" Version="6.0.20262.477" />
    <PackageReference Include="C1.AspNetCore.Api.Report" Version="6.0.20262.433" />
    <PackageReference Include="C1.AspNetCore.Api.DataEngine" Version="6.0.20262.433" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.2" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="project.json" />
    <Content Remove="project.lock.json" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="ControlPages.xml" />
    <EmbeddedResource Include="GCDTLicenses.xml" />
    <EmbeddedResource Include="Startup.cs" />
    <EmbeddedResource Include="Controllers/**/*.cs" />
    <EmbeddedResource Include="DashboardDemo.Core31.sa3licx" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="wwwroot\Content\Reports\CurrentOpportunitiesData.flxr" />
    <None Remove="wwwroot\Content\Reports\ProfitAndSales.flxr" />
    <None Remove="wwwroot\Content\Reports\RegionWiseSalesData.flxr" />
  </ItemGroup>
  <ItemGroup>
    <DotNetCliToolReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Tools" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="DashboardDemo.Core20.sa3licx" />
    <None Remove="DashboardDemo.Net60.sa3licx" />
    <None Remove="DashboardDemo.Net80.sa3licx" />
    <None Remove="DashboardDemo.Net90.sa3licx" />
    <None Remove="DashboardDemo.sa3licx" />
  </ItemGroup>
</Project>
