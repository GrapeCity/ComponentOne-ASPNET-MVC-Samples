  <Report ref="1">
    <Name>MonthlyBudgetChart</Name>
    <DataSourceName>Main</DataSourceName>
    <OnOpen>' -- style script start
    _styleCtr = 0
    ' -- style script end
    </OnOpen>
    <Layout>
      <Width>5220</Width>
      <Margin>0</Margin>
      <MarginTop>0</MarginTop>
      <MarginRight>0</MarginRight>
      <MarginBottom>0</MarginBottom>
