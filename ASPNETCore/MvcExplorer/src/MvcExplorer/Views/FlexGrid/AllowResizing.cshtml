@using C1.Web.Mvc;
@model IEnumerable<Sale>
@{
    ControlOptions optionsModel = ViewBag.DemoOptions;
    ViewBag.DemoSettings = true;
}
<c1-flex-grid id="ovFlexGrid" auto-generate-columns="true" class="grid" is-read-only="true" width="900px"
              allow-resizing=@((C1.Web.Mvc.Grid.AllowResizing)Enum.Parse(typeof(C1.Web.Mvc.Grid.AllowResizing), optionsModel.Options["AllowResizing"].CurrentValue))>
    <c1-items-source read-action-url="@Url.Action("AllowResizing_Bind")"></c1-items-source>
</c1-flex-grid>

@section Settings {
    @await Html.PartialAsync("_OptionsMenu", optionsModel)
}

@section Description {
    <p>@Html.Raw(FlexGridRes.AllowResizing_Description)</p>
    <p>@Html.Raw(FlexGridRes.AllowResizing_Details)</p>
}