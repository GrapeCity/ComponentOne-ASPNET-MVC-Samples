<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>TransposedGridExplorer</AssemblyName>
    <RootNamespace>TransposedGridExplorer</RootNamespace>
    <MvcRazorCompileOnPublish>false</MvcRazorCompileOnPublish>
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    <DefineConstants>$(DefineConstants);NET50</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="ControlPages.xml;Controllers\**\*.cs;GCDTLicenses.xml" Exclude="bin\**;obj\**;**\*.xproj" />
    <EmbeddedResource Include="TransposedGridExplorer.Net80.sa3licx" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="project.json" />
    <Content Remove="project.lock.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="C1.AspNetCore.Mvc" Version="6.0.20262.477" />
    <PackageReference Include="C1.AspNetCore.Mvc.TransposedGrid" Version="6.0.20262.477" />
  </ItemGroup>
  <ItemGroup>
    <DotNetCliToolReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Tools" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="TransposedGridExplorer.Core20.sa3licx" />
    <None Remove="TransposedGridExplorer.Core31.sa3licx" />
    <None Remove="TransposedGridExplorer.Net60.sa3licx" />
    <None Remove="TransposedGridExplorer.Net90.sa3licx" />
    <None Remove="TransposedGridExplorer.sa3licx" />
  </ItemGroup>
</Project>
