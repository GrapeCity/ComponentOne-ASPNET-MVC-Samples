  </ItemGroup>
  <ItemGroup>
    <Content Remove="project.json" />
    <Content Remove="project.lock.json" />
  </ItemGroup>
  <ItemGroup>
    <DotNetCliToolReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Tools" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="ColumnGroups.Core31.sa3licx" />
    <None Remove="ColumnGroups.Net60.sa3licx" />
    <None Remove="ColumnGroups.Net80.sa3licx" />
