
@{
    var today = DateTime.Now.Date;
    var readonlyOptions = new List<string> { "False", "True" };
}
@section Scripts{
    <script>
        function applyCulture() {
            var selCulture = document.getElementById("selCulture");
            wijmo.changeCulture(selCulture.value).then(() => {
                if (selCulture.selectedOptions.length > 0)
                    document.getElementById("curCulture").textContent = selCulture.selectedOptions[0].label;
            });
        }

        function handleReadonlyChanged(sender, args) {
            var inputDatetime = wijmo.Control.getControl('#idcInputDateTime');
            if (sender.selectedValue === "True") {
                inputDatetime.isReadOnly = true;
            } else {
                inputDatetime.isReadOnly = false;
            }
        }
    </script>

   @Html.C1().Scripts().Basic().Culture("ja")
    @Html.C1().Scripts().Basic().Culture("de")
    @Html.C1().Scripts().Basic().Culture("fr")
    @Html.C1().Scripts().Basic().Culture("ko")
    @Html.C1().Scripts().Basic().Culture("en")
   
}

<div>

    <label>@Html.Raw(InputDateTimeRes.Index_Text0)</label>

    <c1-input-date-time id="idcInputDateTime" value="@today">

    </c1-input-date-time>

    <br />
    @Html.Raw(InputDateTimeRes.Index_Text21):&nbsp;&nbsp;<label id="curCulture" style="font-size:14px;font-weight:bold;">English</label>
    <select id="selCulture" size="5" style="width:200px;padding:5px;">
        <option value="en" selected="selected">English</option>
        <option value="ja">Japanese</option>
        <option value="de">German</option>
        <option value="fr">French</option>
        <option value="ko">Korean</option>
    </select>
    <br />
    <button id="btn" onclick="applyCulture()">@Html.Raw(InputDateTimeRes.Index_Text22)</button>
    <p></p>
    <label style="font-weight: normal;margin-top: 1em;">@Html.Raw(InputDateRes.Index_Text2)</label>
    <c1-combo-box selected-index-changed="handleReadonlyChanged">
        <c1-items-source source-collection="@readonlyOptions"></c1-items-source>
    </c1-combo-box>
</div>

@section Description{
    <p>@Html.Raw(InputDateTimeRes.Index_Text1)</p>
    <p>@Html.Raw(InputDateTimeRes.Index_Text2)</p>
    <p>@Html.Raw(InputDateTimeRes.Index_Text3)</p>
}