  <Report ref="1">
    <Name>Candlestick</Name>
    <DataSourceName>Main</DataSourceName>
    <OnOpen>' -- style script start
      _styleCtr = 0
      ' -- style script end
    </OnOpen>
    <ReportInfo>
      <Author>HuangGang</Author>
    </ReportInfo>
    <Layout>
      <Width>10755</Width>
      <Margin>576</Margin>
      <MarginTop>576</MarginTop>
      <MarginRight>576</MarginRight>
      <MarginBottom>576</MarginBottom>
      <Orientation>Portrait</Orientation>
      <CustomPageWidth>11905.5118110236</CustomPageWidth>
      <CustomPageHeight>16837.7952755906</CustomPageHeight>
    </Layout>
    <Fonts>
      <Font>
        <Name>Eras Medium ITC</Name>
        <Size>10</Size>
      </Font>
    </Fonts>
    <DataSources>
      <DataSource>
        <Name>Main</Name>
    <DataProvider>SQLite</DataProvider>
        <ConnectionString>Data Source=wwwroot/App_Data/C1NWind.db</ConnectionString>
        <RecordSource>
          SELECT 
              CAST(strftime('%m', OrderDate) AS INTEGER) AS OrderMonth,
              MAX(Amount) AS HighAmount,
              MIN(Amount) AS LowAmount,
              (SELECT SUM(Quantity * UnitPrice)
              FROM [Order Details] od
              JOIN Orders o ON od.OrderID = o.OrderID
              WHERE CAST(strftime('%Y', o.OrderDate) AS INTEGER) = 2014
                AND CAST(strftime('%m', o.OrderDate) AS INTEGER) = CAST(strftime('%m', main.OrderDate) AS INTEGER)
              ORDER BY o.OrderDate ASC
              LIMIT 1
              ) AS OpenAmount,
              (SELECT SUM(Quantity * UnitPrice)
              FROM [Order Details] od
              JOIN Orders o ON od.OrderID = o.OrderID
              WHERE CAST(strftime('%Y', o.OrderDate) AS INTEGER) = 2014
                AND CAST(strftime('%m', o.OrderDate) AS INTEGER) = CAST(strftime('%m', main.OrderDate) AS INTEGER)
              ORDER BY o.OrderDate DESC
              LIMIT 1
              ) AS CloseAmount
          FROM (
              SELECT o.OrderID, o.OrderDate, SUM(od.Quantity * od.UnitPrice) AS Amount
              FROM Orders o
              JOIN [Order Details] od ON o.OrderID = od.OrderID
              WHERE CAST(strftime('%Y', o.OrderDate) AS INTEGER) = 2014
              GROUP BY o.OrderID
          ) main
          GROUP BY CAST(strftime('%m', OrderDate) AS INTEGER)
          ORDER BY OrderMonth;
        </RecordSource>
      </DataSource>
    </DataSources>
    <Sections>
      <Section>
        <Name>Detail</Name>
        <SubSections>
          <SubSection>
            <Name>SubSection1</Name>
            <Height>360</Height>
          </SubSection>
        </SubSections>
        <Type>Detail</Type>
        <Visible>false</Visible>
        <OnPrint>' -- style script start
            detail.BackColor = iif(_styleCtr mod 2 = 0, rgb(255,255,255),rgb(238,238,238))
            _styleCtr = _styleCtr + 1
            ' -- style script end
            </OnPrint>
      </Section>
      <Section>
        <Name>Header</Name>
        <SubSections>
          <SubSection>
            <Name>SubSection1</Name>
            <Height>10750</Height>
          </SubSection>
        </SubSections>
        <Type>Header</Type>
      </Section>
      <Section>
        <Name>Footer</Name>
        <SubSections>
          <SubSection>
            <Name>SubSection1</Name>
          </SubSection>
        </SubSections>
        <Type>Footer</Type>
        <Visible>false</Visible>
      </Section>
      <Section>
        <Name>PageHeader</Name>
        <SubSections>
          <SubSection>
            <Name>SubSection1</Name>
          </SubSection>
        </SubSections>
        <Type>PageHeader</Type>
      </Section>
      <Section>
