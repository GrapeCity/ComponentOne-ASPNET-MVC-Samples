<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>FlexViewerExplorer</AssemblyName>
    <RootNamespace>FlexViewerExplorer</RootNamespace>
    <MvcRazorCompileOnPublish>false</MvcRazorCompileOnPublish>
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    <DefineConstants>$(DefineConstants);NET50</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Startup.cs;Controllers\**\*.cs;GCDTLicenses.xml" Exclude="bin\**;obj\**;**\*.xproj" />
    <Content Update="wwwroot\App_Data\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="FlexViewerExplorer.Net80.sa3licx" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="project.json" />
    <Content Remove="project.lock.json" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="C1.AspNetCore.Mvc" Version="6.0.20262.477" />
    <PackageReference Include="C1.AspNetCore.Mvc.FlexViewer" Version="6.0.20262.477" />
    <PackageReference Include="C1.AspNetCore.Api" Version="6.0.20262.433" />
    <PackageReference Include="C1.AspNetCore.Api.Document" Version="6.0.20262.433" />
    <PackageReference Include="C1.AspNetCore.Api.Report" Version="6.0.20262.433" />
    <PackageReference Include="C1.AspNetCore.Api.Pdf" Version="6.0.20262.433" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.2.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="3.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="5.0.5" />
    <PackageReference Include="System.ServiceModel.Http" Version="6.2.0" />
  </ItemGroup>
  <ItemGroup>
    <DotNetCliToolReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Tools" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="FlexViewerExplorer.Core20.sa3licx" />
    <None Remove="FlexViewerExplorer.Net60.sa3licx" />
    <None Remove="FlexViewerExplorer.Net90.sa3licx" />
    <None Remove="FlexViewerExplorer.sa3licx" />
  </ItemGroup>
</Project>
