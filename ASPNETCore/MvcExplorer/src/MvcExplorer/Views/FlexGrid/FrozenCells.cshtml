@model IEnumerable<Sale>
<style>
    .wj-frozen.wj-frozen-col, wj-cell.wj-alt.wj-frozen, .wj-frozen-col, .wj-frozen.wj-frozen-col-left, .wj-frozen.wj-frozen-col-right, .wj-frozen.wj-frozen-col-right-edge {
        background-color: yellow;
    }

    .wj-cell.wj-frozen.wj-frozen-row,
    .wj-cell.wj-frozen.wj-frozen-row-bottom {
        background-color: yellow;
    }

    .wj-cell.wj-frozen.wj-frozen-row.wj-alt,
        .wj-cell.wj-frozen.wj-frozen-row-bottom.wj-alt {
        background-color: #e1e1e1;
    }
</style>

<c1-flex-grid id="demoControl" auto-generate-columns="false"
              is-read-only="true" class="grid" frozen-cells="[1,0,0,2]">
    <c1-flex-grid-column binding="ID"></c1-flex-grid-column>
    <c1-flex-grid-column binding="Start" format="MMM d yy"></c1-flex-grid-column>
    <c1-flex-grid-column binding="End" format="HH:mm"></c1-flex-grid-column>
    <c1-flex-grid-column binding="Country"></c1-flex-grid-column>
    <c1-flex-grid-column binding="Product"></c1-flex-grid-column>
    <c1-flex-grid-column binding="Color"></c1-flex-grid-column>
    <c1-flex-grid-column binding="Amount" format="c"></c1-flex-grid-column>
    <c1-flex-grid-column binding="Amount2" format="c"></c1-flex-grid-column>
    <c1-flex-grid-column binding="Discount" format="p0"></c1-flex-grid-column>
    <c1-flex-grid-column binding="Active"></c1-flex-grid-column>
    <c1-items-source read-action-url="@Url.Action("FrozenCells_Bind")"></c1-items-source>

</c1-flex-grid>

@section Settings {
    <div style="padding: 4px 8px">
        <p style="display:inline-block; width: 180px">@Html.Raw(FlexGridRes.FrozenCell_Setting1)</p>
            <c1-input-number id="frzCol" min="0" max="10" width="150" Step="1" value="0" format="n0" value-changed="frozenColumnChange" />
        <p style="display:inline-block; width: 180px">@Html.Raw(FlexGridRes.FrozenCell_Setting2)</p>
            <c1-input-number id="frzColEnd" min="0" max="10" width="150" Step="1" value="2" format="n0" value-changed="frozenColumnEndChange" />
    </div>
    <div style="padding: 4px 8px">
        <p style="display:inline-block; width: 180px">@Html.Raw(FlexGridRes.FrozenCell_Setting3)</p>
        <c1-input-number id="frzRow" min="0" max="10" width="150" Step="1" value="1" format="n0" value-changed="frozenRowChange" />

        <p style="display:inline-block; width: 180px">@Html.Raw(FlexGridRes.FrozenCell_Setting4)</p>
            <c1-input-number id="frzRowEnd" min="0" max="10" width="150" Step="1" value="0" format="n0" value-changed="frozenRowEndChange" />
    </div>
    <div style="margin-top: 10px">
        <input type="button" value="ApplySetting" onclick="applyFrozenCells()" />
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function(){
            wijmo.Control.getControl('#frzCol').isDisabled = true;
            wijmo.Control.getControl('#frzRowEnd').isDisabled = true;
        });
        
        function changeEnableSetting(id, enable) {
            var input = wijmo.Control.getControl('#' + id);
            if (input != null) {
                if (enable) {
                    input.isDisabled = false;
                } else {
                    input.value = 0;
                    input.isDisabled = true;
                }
            }
        }
        function frozenColumnChange(sender, args) {
            changeEnableSetting('frzColEnd', sender.value == 0);
        }
        function frozenColumnEndChange(sender, args) {
            changeEnableSetting('frzCol', sender.value == 0);
        }
        function frozenRowChange(sender, args) {
            changeEnableSetting('frzRowEnd', sender.value == 0);
        }
        function frozenRowEndChange(sender, args) {
            changeEnableSetting('frzRow', sender.value == 0);
        }

        function applyFrozenCells() {
            var grid = wijmo.Control.getControl('#demoControl');
            var inputFrzColumn = wijmo.Control.getControl('#frzCol');
            var inputFrzColumnEnd = wijmo.Control.getControl('#frzColEnd');
            var inputFrzRow = wijmo.Control.getControl('#frzRow');
            var inputFrzRowEnd = wijmo.Control.getControl('#frzRowEnd');

            grid.rows.frozen = inputFrzRow.value;
            grid.rows.frozenEnd = inputFrzRowEnd.value;
            grid.columns.frozen = inputFrzColumn.value;
            grid.columns.frozenEnd = inputFrzColumnEnd.value;

            grid.invalidate();
        }

    </script>
}
@section Description{
    @Html.Raw(FlexGridRes.FrozenCells_Text0)<p></p>
    <p><b>@Html.Raw(FlexGridRes.FrozenCells_Text1)</b></p>
        - @Html.Raw(FlexGridRes.FrozenCells_Text2)
    <br />
        - @Html.Raw(FlexGridRes.FrozenCells_Text3)
    <br />
        - @Html.Raw(FlexGridRes.FrozenCells_Text4)
    <br />
    <br />
    <p>
        @Html.Raw(FlexGridRes.FrozenCells_Text5)
    </p>
}
