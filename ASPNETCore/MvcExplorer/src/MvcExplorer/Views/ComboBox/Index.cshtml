@{
    ControlOptions optionsModel = ViewBag.DemoOptions;
    ViewBag.DemoSettings = true;
    List<string> countries = ViewBag.Countries;
    List<string> cities = ViewBag.Cities;
    string vThreshold = optionsModel.Options["Virtualization Threshold"].CurrentValue;
}

<script>
        function addTooltips() {
        let tt = new wijmo.Tooltip();
        let groupPanelEl1 = document.querySelector('[aria-labelledby="comboboxNonEditLabel"]');
            if (groupPanelEl1) {
         tt.setTooltip(groupPanelEl1, "Non Editable Combo Box");
    }

      let groupPanelEl2 = document.querySelector('[aria-labelledby="comboboxEditLabel"]');
            if (groupPanelEl2) {
         tt.setTooltip(groupPanelEl2, "Editable Combo Box");
    }
    }
    window.onload = () => {
        addTooltips();
    };
</script>

<div>
    <label>@Html.Raw(ComboBoxRes.Index_NonEditable)</label>
    <c1-combo-box selected-index="0" is-editable="false" max-drop-down-width="55"
                  case-sensitive-search="@Convert.ToBoolean(optionsModel.Options["Case Sensitive Search"].CurrentValue)"
                  handle-wheel="@Convert.ToBoolean(optionsModel.Options["Handle Wheel"].CurrentValue)"
                  virtualization-threshold="@vThreshold.Equals("Disable") ? int.MaxValue : int.Parse(vThreshold)"

                  key-action-down-arrow="@(Enum.TryParse<InputKeyAction>(
                      optionsModel.Options["Key Action Down Arrow"].CurrentValue?.ToString(),
                      out var action) ? action : InputKeyAction.ChangeSelectionOnly)"

                  key-action-up-arrow="@(Enum.TryParse<InputKeyAction>(
                      optionsModel.Options["Key Action Up Arrow"].CurrentValue?.ToString(),
                      out var action1) ? action1 : InputKeyAction.ChangeSelectionOnly)"

                  key-action-print-characters="@(Enum.TryParse<InputKeyAction>(
                      optionsModel.Options["Key Action Print Characters"].CurrentValue?.ToString(),
                      out var action2) ? action2 : InputKeyAction.ChangeSelectionOnly)"

                  key-action-tab="@(Enum.TryParse<TabKeyAction>(
                                        optionsModel.Options["Key Action Tab"].CurrentValue?.ToString(),
                      out var action3) ? action3 : TabKeyAction.CloseAndMoveFocus)"
                  aria-labelled-by="comboboxNonEditLabel">

        <c1-items-source source-collection="@countries"></c1-items-source>
    </c1-combo-box>
</div>
<div>
    <label>@Html.Raw(ComboBoxRes.Index_Editable)</label>
    <c1-combo-box selected-index="0" is-editable="true"
                  case-sensitive-search="@Convert.ToBoolean(optionsModel.Options["Case Sensitive Search"].CurrentValue)"
                  handle-wheel="@Convert.ToBoolean(optionsModel.Options["Handle Wheel"].CurrentValue)"
                  virtualization-threshold="@vThreshold.Equals("Disable") ? int.MaxValue : int.Parse(vThreshold)"

                  key-action-down-arrow="@(Enum.TryParse<InputKeyAction>(
                  optionsModel.Options["Key Action Down Arrow"].CurrentValue?.ToString(),
                  out var action4) ? action4 : InputKeyAction.ChangeSelectionOnly)"

                  key-action-up-arrow="@(Enum.TryParse<InputKeyAction>(
                  optionsModel.Options["Key Action Up Arrow"].CurrentValue?.ToString(),
                  out var action5) ? action5 : InputKeyAction.ChangeSelectionOnly)"

                  key-action-print-characters="@(Enum.TryParse<InputKeyAction>(
                  optionsModel.Options["Key Action Print Characters"].CurrentValue?.ToString(),
                  out var action6) ? action6 : InputKeyAction.ChangeSelectionOnly)"

                  key-action-tab="@(Enum.TryParse<TabKeyAction>(
                                    optionsModel.Options["Key Action Tab"].CurrentValue?.ToString(),
                  out var action7) ? action7 : TabKeyAction.CloseAndMoveFocus)"
                  aria-labelled-by="comboboxEditLabel">

        <c1-items-source source-collection="@cities"></c1-items-source>
    </c1-combo-box>
</div>

@section Settings{
    @await Html.PartialAsync("_OptionsMenu", optionsModel)
}

@section Description{
    @Html.Raw(ComboBoxRes.Index_Text0)
    <br />
    @Html.Raw(ComboBoxRes.CaseSensitiveSearchDescription_Text0)
    <br />
    @Html.Raw(ComboBoxRes.HandleWheelDescription_Text0)
    <br />
    @Html.Raw(ComboBoxRes.Index_Text1)
    <br /><br/>
    @Html.Raw(ComboBoxRes.Index_ActionsDirectionNPrint)
    <br /><br/>
    @Html.Raw(ComboBoxRes.Index_ActionsTab)
    <br />
    <br />
    @Html.Raw(ComboBoxRes.Index_Tooltip)
}