<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <AssemblyName>MultipleControlsBinding</AssemblyName>
    <RootNamespace>MultipleControlsBinding</RootNamespace>
    <DefineConstants>$(DefineConstants);NETCORE31</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="GCDTLicenses.xml" Exclude="bin\**;obj\**;**\*.xproj;packages\**;@(EmbeddedResource)" />
    <EmbeddedResource Include="MultipleControlsBinding.Core31.sa3licx" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="C1.AspNetCore.Mvc" Version="6.0.20231.344" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="project.json" />
    <Content Remove="project.lock.json" />
  </ItemGroup>
  <ItemGroup>
    <DotNetCliToolReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Tools" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="MultipleControlsBinding.Core20.sa3licx" />
    <None Remove="MultipleControlsBinding.Net60.sa3licx" />
    <None Remove="MultipleControlsBinding.Net80.sa3licx" />
    <None Remove="MultipleControlsBinding.Net90.sa3licx" />
    <None Remove="MultipleControlsBinding.sa3licx" />
  </ItemGroup>
</Project>
