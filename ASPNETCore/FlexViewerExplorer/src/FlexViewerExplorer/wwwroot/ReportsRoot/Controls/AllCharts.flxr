          </SubSection>
        </SubSections>
        <Type>Detail</Type>
        <Visible>false</Visible>
        <OnPrint>' -- style script start
          detail.BackColor = iif(_styleCtr mod 2 = 0, rgb(255,255,255),rgb(238,238,238))
          _styleCtr = _styleCtr + 1
          ' -- style script end
        </OnPrint>
      </Section>
      <Section>
        <Name>Header</Name>
        <SubSections>
          <SubSection>
            <Name>SubSection1</Name>
            <Height>11125</Height>
