    </Layout>
    <Fonts>
      <Font>
        <Name>Segoe UI</Name>
        <Size>9</Size>
      </Font>
    </Fonts>
    <DataSources>
      <DataSource>
        <Name>Main</Name>
        <DataProvider>SQLite</DataProvider>
        <ConnectionString>Data Source=wwwroot/App_Data/C1NWind.db</ConnectionString>
        <RecordSource>SELECT MonthlyBudget.Tran_MainType,Sum(MonthlyBudget.Estimated_Value) As Estimated, Sum(MonthlyBudget.Actual_Value) As Actual, Sum( iif(MonthlyBudget.Tran_Type = 'Income' ,MonthlyBudget.Actual_Value- MonthlyBudget.Estimated_Value,MonthlyBudget.Estimated_Value-MonthlyBudget.Actual_Value)) AS Difference
    FROM MonthlyBudget group by MonthlyBudget.Tran_MainType ;
    </RecordSource>
      </DataSource>
    </DataSources>
    <Groups>
      <Group>
        <Name>Tran_Type</Name>
        <KeepTogether>KeepFirstDetail</KeepTogether>
