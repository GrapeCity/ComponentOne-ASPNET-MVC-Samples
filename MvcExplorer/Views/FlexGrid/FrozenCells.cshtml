@using C1.Web.Mvc.Grid
@model IEnumerable<Sale>

<style>
    .wj-frozen.wj-frozen-col, wj-cell.wj-alt.wj-frozen, .wj-frozen.wj-frozen-col-left, .wj-frozen.wj-frozen-col-right, .wj-frozen.wj-frozen-col-right-edge {
        background-color: yellow;
    }

    .wj-cell.wj-frozen.wj-frozen-row,
    .wj-cell.wj-frozen.wj-frozen-row-bottom {
        background-color: yellow;
    }

    .wj-cell.wj-frozen.wj-frozen-row.wj-alt,
    .wj-cell.wj-frozen.wj-frozen-row-bottom.wj-alt {
        background-color: #e1e1e1;
    }
</style>

@(Html.C1().FlexGrid<Sale>().Id("demoControl")
    .AutoGenerateColumns(false)
    .IsReadOnly(true)
    .Bind(Model)
    .CssClass("grid")
    .Columns(columns =>
    {
        columns.Add(column => column.Binding("ID"));
        columns.Add(column => column.Binding("Start").Format("MMM d yy"));
        columns.Add(column => column.Binding("End").Format("HH:mm"));
        columns.Add(column => column.Binding("Country"));
        columns.Add(column => column.Binding("Product"));
        columns.Add(column => column.Binding("Color"));
        columns.Add(column => column.Binding("Amount").Format("c"));
        columns.Add(column => column.Binding("Amount2").Format("c"));
        columns.Add(column => column.Binding("Discount").Format("p0"));
        columns.Add(column => column.Binding("Active"));
    })
    .FrozenCells(1,0,0,2)
)

@section Settings{
    <div style="padding: 4px 8px">
        <p style="display:inline-block; width: 180px">@Html.Raw(Resources.FlexGrid.FrozenCell_Setting1)</p>
        @(Html.C1().InputNumber().Id("frzCol").Width(150).Min(0).Max(10).Step(1).Value(0).Format("n0").OnClientValueChanged("frozenColumnChange"))

        <p style="display:inline-block; width: 180px">@Html.Raw(Resources.FlexGrid.FrozenCell_Setting2)</p>
        @(Html.C1().InputNumber().Id("frzColEnd").Width(150).Min(0).Max(10).Step(1).Value(2).Format("n0").OnClientValueChanged("frozenColumnEndChange"))
    </div>
    <div style="padding: 4px 8px">
        <p style="display:inline-block; width: 180px">@Html.Raw(Resources.FlexGrid.FrozenCell_Setting3)</p>
        @(Html.C1().InputNumber().Id("frzRow").Width(150).Min(0).Max(10).Step(1).Value(1).Format("n0").OnClientValueChanged("frozenRowChange"))

        <p style="display:inline-block; width: 180px">@Html.Raw(Resources.FlexGrid.FrozenCell_Setting4)</p>
        @(Html.C1().InputNumber().Id("frzRowEnd").Width(150).Min(0).Max(10).Step(1).Value(0).Format("n0").OnClientValueChanged("frozenRowEndChange"))
    </div>
    <div style="margin-top: 10px">
        <input type="button" value="ApplySetting" onclick="applyFrozenCells()" />
    </div>
}

@section Scripts{
    <script>
        $(document).ready(function(){
            wijmo.Control.getControl('#frzCol').isDisabled = true;
            wijmo.Control.getControl('#frzRowEnd').isDisabled = true;
        });
        
        function changeEnableSetting(id, enable) {
            var input = wijmo.Control.getControl('#' + id);
            if (input != null) {
                if (enable) {
                    input.isDisabled = false;
                } else {
                    input.value = 0;
                    input.isDisabled = true;
                }
            }
        }
        function frozenColumnChange(sender, args) {
            changeEnableSetting('frzColEnd', sender.value == 0);
        }
        function frozenColumnEndChange(sender, args) {
            changeEnableSetting('frzCol', sender.value == 0);
        }
        function frozenRowChange(sender, args) {
            changeEnableSetting('frzRowEnd', sender.value == 0);
        }
        function frozenRowEndChange(sender, args) {
            changeEnableSetting('frzRow', sender.value == 0);
        }

        function applyFrozenCells() {
            var grid = wijmo.Control.getControl('#demoControl');
            var inputFrzColumn = wijmo.Control.getControl('#frzCol');
            var inputFrzColumnEnd = wijmo.Control.getControl('#frzColEnd');
            var inputFrzRow = wijmo.Control.getControl('#frzRow');
            var inputFrzRowEnd = wijmo.Control.getControl('#frzRowEnd');

            grid.rows.frozen = inputFrzRow.value;
            grid.rows.frozenEnd = inputFrzRowEnd.value;
            grid.columns.frozen = inputFrzColumn.value;
            grid.columns.frozenEnd = inputFrzColumnEnd.value;

            grid.invalidate();
        }

    </script>
}
@section Description{
    @Html.Raw(Resources.FlexGrid.FrozenCells_Text0)<p></p>
    <p><b>@Html.Raw(Resources.FlexGrid.FrozenCells_Text1)</b></p>
    - @Html.Raw(Resources.FlexGrid.FrozenCells_Text2)<br />
    - @Html.Raw(Resources.FlexGrid.FrozenCells_Text3)<br />
    - @Html.Raw(Resources.FlexGrid.FrozenCells_Text4)<br />
    <br />
    <p>
        @Html.Raw(Resources.FlexGrid.FrozenCells_Text5)
    </p>

}
