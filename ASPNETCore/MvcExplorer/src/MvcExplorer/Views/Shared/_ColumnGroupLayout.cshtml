<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title@(FlexGridColumnGroupingRes.Layout_TitleSuffix)</title>
    <link rel="apple-touch-icon" sizes="180x180" href="@Url.Content("~/Content/favicon/apple-touch-icon180.png")">
    <link rel="icon" type="image/png" href="@Url.Content("~/Content/favicon/logo32.png")" sizes="32x32">
    <link rel="icon" type="image/png" href="@Url.Content("~/Content/favicon/logo16.png")" sizes="16x16">
    <link rel="manifest" href="@Url.Content("~/Content/favicon/manifest.json")">
    <link rel="mask-icon" href="@Url.Content("~/Content/favicon/safari-pinned-tab.svg")" color="#697683">

    <link rel="stylesheet" href="https://netdna.bootstrapcdn.com/bootstrap/3.1.1/css/bootstrap.min.css" />
    <link rel="stylesheet" href="//maxcdn.bootstrapcdn.com/font-awesome/4.1.0/css/font-awesome.min.css" />
    <link rel="stylesheet" href="@Url.Content(Resource.GcIconsCssPath)" />
    <link rel="stylesheet" href="@Url.Content("~/Content/css/ColumnGroupApp.css")" />
    <c1-styles />

    <c1-scripts>
        <c1-basic-scripts bundles="Input">
            <c1-grid-extension-scripts bundles="Filter" />
        </c1-basic-scripts>
    </c1-scripts>
    <script src="~/Scripts/jquery.js"></script>
    <script src="~/Scripts/MultiLevelMenu.js"></script>
    <script src="~/Scripts/ColumnGroupProvider.js"></script>
    <script src="~/Scripts/app.js"></script>
</head>
    <body>
        <div class="hide">
            @await Html.PartialAsync("_SiteNav", true)
        </div>
        <header>
            <div class="hamburger-nav-btn narrow-screen"><span class="icon-bars-w"></span></div>
            <div class="menu-container">
                <div class="menu-left">
                <a href="@(FlexGridColumnGroupingRes.Layout_ProductUrl)" target="_blank">
                        <img src="~/Content/images/logotext_w.png" class="gcicon-logo-gc-horiz" alt="mescius" />
                    </a>
                </div>
                <div class="menu-divide"></div>
                <div class="menu-main">
                <span class="semi-bold narrow-screen">ComponentOne @FlexGridColumnGroupingRes.Layout_ShortTitle</span>
                <span class="semi-bold wide-screen">ComponentOne @FlexGridColumnGroupingRes.Layout_LongTitle</span>
                </div>
                <div class="menu-right">
                    @await Html.PartialAsync("_SiteNav", false)
                </div>
        </div>
        </header>
        <div class="container">
            @RenderBody()
        </div>
        <footer>
        <a href="@(FlexGridColumnGroupingRes.Layout_Url)">
                <img src="~/Content/images/logotext.png" class="gcicon-logo-gc-horiz" alt="mescius" />
            </a>
            <p>
            © @DateTime.Now.Year @Html.Raw(FlexGridColumnGroupingRes.Layout_License1)<br />
                @Html.Raw(FlexGridColumnGroupingRes.Layout_License2)
            </p>
        </footer>
    </body>
</html>
