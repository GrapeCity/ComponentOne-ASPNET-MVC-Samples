  <Report ref="1">
    <Name>MonthlyTop5Expenses</Name>
    <DataSourceName>Main</DataSourceName>
    <OnOpen>' -- style script start
    _styleCtr = 0
    ' -- style script end
    </OnOpen>
    <Layout>
      <Width>5025</Width>
      <Margin>0</Margin>
      <MarginTop>0</MarginTop>
      <MarginRight>0</MarginRight>
      <MarginBottom>0</MarginBottom>
      <Orientation>Portrait</Orientation>
      <CustomPageWidth>11905.5118110236</CustomPageWidth>
      <CustomPageHeight>16837.7952755906</CustomPageHeight>
    </Layout>
    <Fonts>
      <Font>
        <Name>Segoe UI</Name>
        <Size>9</Size>
      </Font>
    </Fonts>
    <DataSources>
      <DataSource>
        <Name>Main</Name>
        <DataProvider>SQLite</DataProvider>
        <ConnectionString>Data Source=wwwroot/App_Data/C1NWind.db</ConnectionString>
        <RecordSource>select Tran_Name,Actual_Value,ExpensesTotal from MonthlyBudget as t1 inner join (SELECT MonthlyBudget.Tran_MainType,Sum(MonthlyBudget.Actual_Value) as ExpensesTotal
    FROM MonthlyBudget group by MonthlyBudget.Tran_MainType) as t on  t1.Tran_MainType=t.Tran_MainType
    Where Tran_Type='Operating Expenses' order by Actual_Value desc limit 5;</RecordSource>
      </DataSource>
    </DataSources>
    <Groups>
      <Group>
        <Name>Tran_Type</Name>
        <KeepTogether>KeepFirstDetail</KeepTogether>
      </Group>
    </Groups>
