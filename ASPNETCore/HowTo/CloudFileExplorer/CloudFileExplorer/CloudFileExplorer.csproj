<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>CloudFileExplorer</AssemblyName>
    <RootNamespace>CloudFileExplorer</RootNamespace>
    <MvcRazorCompileOnPublish>false</MvcRazorCompileOnPublish>
    <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    <DefineConstants>$(DefineConstants);NETCORE31</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="ControlPages.xml;Controllers\**\*.cs;GCDTLicenses.xml" Exclude="bin\**;obj\**;**\*.xproj" />
    <EmbeddedResource Include="CloudFileExplorer.sa3licx" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="credentials.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="C1.AspNetCore.Api" Version="6.0.20262.433" />
    <PackageReference Include="C1.AspNetCore.Api.Cloud" Version="6.0.20262.433" />
    <PackageReference Include="C1.AspNetCore.Mvc" Version="6.0.20262.477" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Localization\CloudFileRes.resx">
      <Generator>
      </Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Remove="CloudFileExplorer.Core20.sa3licx" />
    <None Remove="CloudFileExplorer.Core31.sa3licx" />
    <None Remove="CloudFileExplorer.Net60.sa3licx" />
    <None Remove="CloudFileExplorer.Net80.sa3licx" />
    <None Remove="CloudFileExplorer.Net90.sa3licx" />
  </ItemGroup>
</Project>
