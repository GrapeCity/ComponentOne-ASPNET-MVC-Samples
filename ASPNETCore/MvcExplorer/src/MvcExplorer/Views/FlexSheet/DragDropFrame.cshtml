@{
    Layout = null;
    Theme.SetCurrentTheme(Context, Context.Request.Query["theme"]);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <c1-styles theme="@Theme.GetCurrentTheme(Context)" />
    <link href="~/Content/css/bootstrap/css/bootstrap.css" rel="stylesheet" />
    <link href="~/Content/css/explorer.css" rel="stylesheet" />
    <link href="~/Content/css/app.css" rel="stylesheet" />
    <style>

            html,
            body {
                margin: 0;
                min-height: 100%;
            }

            body {
                position: relative;
                padding: 0;
                overflow: hidden;
            }

            .drag-drop-frame-content {
                width: 100%;
            }
    </style>
    <script src="~/Scripts/jquery.js"></script>
    <script src="~/Scripts/jszip.js"></script>
    <c1-scripts>
        <c1-basic-scripts bundles="Input" />
        <c1-flex-sheet-scripts />
    </c1-scripts>
    <script type="text/javascript" src="~/Scripts/flexSheet/dragDrop.js"></script>
</head>
<body>
    <div class="drag-drop-frame-content">
        <c1-flex-sheet id="dragDropSheet" class="flexSheet">
            <c1-unbound-sheet column-count="8" row-count="20"></c1-unbound-sheet>
        </c1-flex-sheet>
    </div>
</body>
</html>

