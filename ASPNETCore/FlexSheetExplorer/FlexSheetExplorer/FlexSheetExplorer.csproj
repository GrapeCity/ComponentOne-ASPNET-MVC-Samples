<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FlexSheetExplorer</AssemblyName>
    <RootNamespace>FlexSheetExplorer</RootNamespace>
    <MvcRazorCompileOnPublish>false</MvcRazorCompileOnPublish>
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    <DefineConstants>$(DefineConstants);NETCORE31</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="ControlPages.xml;Controllers\**\*.cs;GCDTLicenses.xml" Exclude="bin\**;obj\**;**\*.xproj" />
    <EmbeddedResource Include="FlexSheetExplorer.sa3licx" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="project.json" />
    <Content Remove="project.lock.json" />
  </ItemGroup>
  <ItemGroup>
    <DotNetCliToolReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Tools" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="C1.AspNetCore.Mvc" Version="6.0.20262.477" />
    <PackageReference Include="C1.AspNetCore.Mvc.FlexSheet" Version="6.0.20262.477" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Localization\FlexSheetRes.zh-CN.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Remove="FlexSheetExplorer.Core20.sa3licx" />
    <None Remove="FlexSheetExplorer.Core31.sa3licx" />
    <None Remove="FlexSheetExplorer.Net60.sa3licx" />
    <None Remove="FlexSheetExplorer.Net80.sa3licx" />
    <None Remove="FlexSheetExplorer.Net90.sa3licx" />
  </ItemGroup>
</Project>
